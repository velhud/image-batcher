{
  "name": "imagen-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test:ui": "npm run typecheck && vite build --mode renderer-test && node --test tests/ui-smoke.cjs",
    "build": "npm run typecheck && vite build && electron-builder",
    "app": "npm run build && electron .",
    "test:desktop": "node --test tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.28.0",
    "playwright": "1.62.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "io.github.velhud.imageai",
    "productName": "Image Batcher",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "backend/app",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "backend/LICENSE"
      }
    ]
  }
}
